# 复制到仓库根 .env；这里只放公开配置，不放口令或客户端秘密。
RADISHINK_ORIGIN=https://ink.example.invalid
RADISHINK_BASE_PATH=/
RADISHINK_PORT=8080
RADISHINK_BIND=127.0.0.1
RADISHINK_ENV=production
RADISHINK_PASSWORD_LOGIN=true
# 本机 HTTP 验证同时改为 RADISHINK_ENV=development，
# RADISHINK_ORIGIN=http://127.0.0.1:8080。生产必须 HTTPS。

# 默认按账号隔离；shared 无用户隔离，必须同时设置 RADISHINK_PASSWORD_LOGIN=false 并关闭 OIDC。
RADISHINK_ACCOUNT_MODE=accounts
