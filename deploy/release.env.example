# 公开部署配置。镜像由独立 release lock 固定，勿写入密码或客户端 secret。
RADISHINK_ORIGIN=https://ink.example.invalid
RADISHINK_BASE_PATH=/
RADISHINK_BIND=127.0.0.1
RADISHINK_PORT=8080
RADISHINK_ENV=production
RADISHINK_ACCOUNT_MODE=accounts
RADISHINK_PASSWORD_LOGIN=true
# 必须先显式准备并初始化；备份卷与工作区卷必须不同，均为普通 local 命名卷。
RADISHINK_WORKSPACE_VOLUME=radishink-workspace
RADISHINK_BACKUP_VOLUME=radishink-backups
