{
  "name": "RadishInk release tag creation",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v[0-9][0-9].[0-9]*.[0-9]*-dev",
        "refs/tags/v[0-9][0-9].[0-9]*.[0-9]*-test",
        "refs/tags/v[0-9][0-9].[0-9]*.[0-9]*-release"
      ],
      "exclude": []
    }
  },
  "rules": [{ "type": "creation" }]
}
