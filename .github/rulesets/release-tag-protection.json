{
  "name": "RadishInk release tag protection",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v[0-9][0-9].[0-9]*.[0-9]*-dev",
        "refs/tags/v[0-9][0-9].[0-9]*.[0-9]*-test",
        "refs/tags/v[0-9][0-9].[0-9]*.[0-9]*-release"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "update",
      "parameters": { "update_allows_fetch_and_merge": false }
    },
    { "type": "deletion" }
  ]
}
