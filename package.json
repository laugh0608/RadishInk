{
  "name": "wemd-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.0.2",
  "engines": {
    "node": "22.x",
    "pnpm": "9.0.2"
  },
  "scripts": {
    "check:repo": "node scripts/check-repo.mjs",
    "test:governance": "node --test scripts/check-repo.test.mjs scripts/release-metadata.test.mjs scripts/generate-web-notices.test.mjs",
    "lint:web": "pnpm --filter @wemd/web run lint",
    "test:web": "pnpm --filter @wemd/core --filter @wemd/web run test:ci",
    "build:web": "pnpm --filter @wemd/web run build",
    "validate:web": "pnpm check:repo && pnpm test:governance && pnpm lint:web && pnpm test:web && pnpm build:web",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @wemd/web run dev",
    "dev:electron": "ELECTRON_START_URL=http://localhost:5173 NODE_ENV=development pnpm --filter wemd-electron run dev -- --dev",
    "dev:desktop": "node scripts/run-desktop-dev.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test:ci --concurrency=1 --continue=always",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "check:release-tag": "node scripts/release-metadata.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.0.0",
    "turbo": "^2.7.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.50.0",
    "wait-on": "^7.0.1",
    "yaml": "2.8.2"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.16"
    }
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/core/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
